{
  "name": "nx-ft",
  "version": "0.1.0",
  "description": "多风格 UI 组件库 + agent-facing studio",
  "type": "module",
  "bin": {
    "nx-ft": "bin/ft.mjs"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./manifest": "./src/manifest/catalog.json",
    "./styles": "./src/styles",
    "./tokens": "./src/tokens",
    "./layout": "./src/layout",
    "./components": "./src/styles/paper/components"
  },
  "files": [
    "bin",
    "src",
    "assets",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "manifest:build": "node src/manifest/build.mjs",
    "showcase:build": "node tools/build-flutter-showcase.mjs",
    "build": "pnpm run manifest:build && vite build",
    "dev": "node scripts/dev.mjs",
    "dev:vite": "vite --host 127.0.0.1",
    "dev:serve": "node bin/ft.mjs serve --no-open",
    "start": "pnpm run build && node bin/ft.mjs serve",
    "link:local": "node scripts/link-local.mjs",
    "unlink:local": "node scripts/link-local.mjs --unlink",
    "lint": "eslint .",
    "test": "pnpm run lint && pnpm run build && pnpm run test:smoke && pnpm run test:unit",
    "test:smoke": "node tests/smoke.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "logo": "node tools/logo-gen/cli.mjs"
  },
  "packageManager": "pnpm@10.33.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/On-DevPlan/nx-ft.git"
  },
  "license": "MIT",
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "vite": "^6.0.7"
  }
}
