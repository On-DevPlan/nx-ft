{
  "name": "nx-ft",
  "version": "0.3.0",
  "description": "本机前端工程化资源管理：HTML/SVG 渲染沙盒、分组+标签+多风格资源库与编辑历史、SVG 图标集规范与四层看板，CLI 与 Web 面板同源",
  "type": "module",
  "bin": {
    "nx-ft": "bin/ft.mjs"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "assets",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "node scripts/dev.mjs",
    "dev:vite": "vite --host 127.0.0.1",
    "dev:serve": "node bin/ft.mjs serve --no-open",
    "start": "pnpm run build && node bin/ft.mjs serve",
    "link:local": "node scripts/link-local.mjs",
    "unlink:local": "node scripts/link-local.mjs --unlink",
    "lint": "eslint .",
    "uiux:score": "node scripts/score-uiux.mjs",
    "test": "pnpm run lint && pnpm run build && pnpm run test:smoke && pnpm run test:unit && pnpm run uiux:score",
    "test:smoke": "node tests/smoke.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "logo": "node tools/logo-gen/cli.mjs"
  },
  "packageManager": "pnpm@10.33.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/On-DevPlan/nx-ft.git"
  },
  "license": "MIT",
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.0",
    "vite": "^6.0.7"
  }
}
