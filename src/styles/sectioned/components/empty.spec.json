{
  "id": "empty",
  "category": "display",
  "title": "空状态",
  "description": "无数据时占位 UI。sectioned 风格：宽 40px padding、12px 圆角、soft 底色、Stripe Dashboard 气质。",
  "classContract": ".empty-state > [.empty-icon] + .empty-title + [.empty-desc] + [.empty-action]",
  "classes": ["empty-state", "empty-icon", "empty-title", "empty-desc", "empty-action"],
  "dom": "<div class=\"empty-state\"><div class=\"empty-title\">暂无数据</div><div class=\"empty-desc\">还没有任何记录</div></div>",
  "props": {
    "title": { "type": "string", "required": true },
    "description": { "type": "string" },
    "icon": { "type": "node" },
    "action": { "type": "node" }
  },
  "tokens": ["--ink", "--mid", "--soft", "--paper"],
  "examples": [
    { "title": "basic", "html": "<div class=\"empty-state\"><div class=\"empty-title\">暂无数据</div><div class=\"empty-desc\">还没有任何记录</div></div>" }
  ]
}
