{
  "id": "btn",
  "category": "action",
  "title": "按钮",
  "description": "主操作触发器。32px 高、8px 圆角、软边框，宽松版式。",
  "classContract": ".btn[.ghost|.small|.danger]",
  "classes": [
    "btn",
    "btn.ghost",
    "btn.small",
    "btn.danger"
  ],
  "dom": "<button class=\"btn\">label</button>",
  "props": {
    "variant": {
      "type": "enum",
      "values": [
        "",
        "ghost",
        "danger"
      ],
      "default": "",
      "description": "视觉变体：默认实色、ghost 浅边、danger 危险色"
    },
    "size": {
      "type": "enum",
      "values": [
        "",
        "small"
      ],
      "default": "",
      "description": "尺寸：默认 28px、small 22px"
    },
    "disabled": {
      "type": "boolean",
      "default": false
    }
  },
  "tokens": [
    "--ink",
    "--paper",
    "--bad",
    "--soft-2"
  ],
  "examples": [
    {
      "title": "primary",
      "html": "<button class=\"btn\">确定</button>"
    },
    {
      "title": "ghost",
      "html": "<button class=\"btn ghost\">取消</button>"
    },
    {
      "title": "danger",
      "html": "<button class=\"btn danger\">删除</button>"
    },
    {
      "title": "small",
      "html": "<button class=\"btn small\">次要</button>"
    }
  ]
}