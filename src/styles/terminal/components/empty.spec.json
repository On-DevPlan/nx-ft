{
  "id": "empty",
  "category": "display",
  "title": "空状态",
  "description": "无数据时占位 UI。terminal 风格：monospace、单元格级 grid、ASCII 风 frame。",
  "classContract": ".empty-state > [.empty-icon] + .empty-title + [.empty-desc] + [.empty-action]",
  "classes": ["empty-state", "empty-icon", "empty-title", "empty-desc", "empty-action"],
  "dom": "<div class=\"empty-state\"><div class=\"empty-title\">NO DATA</div><div class=\"empty-desc\">no records</div></div>",
  "props": {
    "title": { "type": "string", "required": true },
    "description": { "type": "string" },
    "icon": { "type": "node" },
    "action": { "type": "node" }
  },
  "tokens": ["--ink", "--mid", "--soft-2", "--paper"],
  "examples": [
    { "title": "basic", "html": "<div class=\"empty-state\"><div class=\"empty-title\">NO DATA</div><div class=\"empty-desc\">no records found</div></div>" }
  ]
}
