node_modules/
src/web/public/
*.log
.DS_Store
.env
.env.local
.nx-rp-workflows/
*.tgz

# ============================================================
# Cloned repositories (nested git repos) — sl-git-standard
# 父目录必须用 /* 半透明模式，否则否定规则失效
# ============================================================
.claude/repo/*
!.claude/repo/_read/
!.claude/repo/_read/**

!.claude/repo/_self/
!.claude/repo/_self/**

# git.remote 清单：团队共享状态，入库（别人 clone 本仓库后 sync 即可重建 .claude/repo）
!.claude/www/

# Tool artifacts / scratch tools (本地工具产物，不入库)
.tool/

# 会话草稿：原型 / 验证脚本（HTML 原型本地交付、临时核对的 mjs）
temp/

# Playwright MCP 调试产物（浏览器自动化临时日志/快照）
.playwright-mcp/
.claude/
.gstack/

# 截图 / 渲染核对产物（放仓库根目录的那些，不入库）。
# 加这条是因为真踩过两次：提交时用 `git add -A`，把浏览器截图的 PNG 一起扫进版本库，
# 事后还得专门提交一次「清理误提交的截图」。根目录限定（/*.png）不影响 assets/ 下的图片。
/*.png
.claude/settings.local.json
